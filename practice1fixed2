def main(): 
    start=0
    s_start=0
    s_delta=0
    delta=0
    length=0
    s_length=1
    num1=int(input("Insert 1st number:"))
    while num1!=-1 and num1>0:
        num2=int(input("Insert next number, end with -1:"))
        if num2==-1 or num2<0:
            num1=num2
        else:
            s_delta=num2-num1
            s_length+=1
            if num2-num1!=delta and s_length>length:
                start=s_start
                length=s_length-1
                delta=s_delta
                s_start=num1
                s_length=2
            start=s_start
            length=s_length-1
            delta=s_delta
            num1=num2
    if num1==-1:
        print("Longest mathematical series start with %d, delta of %d, length of %d"%(start,delta,length))
    else:
        print("Illigal data!")
main()
        
    